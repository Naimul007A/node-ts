{
    "name": "photos",
    "version": "1.0.0",
    "main": "dist/server.js",
    "license": "MIT",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "ts-node-dev -r tsconfig-paths/register ./src/server.ts",
        "build": "tsc && tsc-alias",
        "build:2": "tsc && tsc-alias && node ./dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "prepare": "husky",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck",
        "check:fix": "pnpm lint:fix && pnpm format && pnpm typecheck"
    },
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "drizzle-orm": "^0.45.4",
        "express": "^4.22.1",
        "express-rate-limit": "^8.7.1",
        "http-errors": "^2.0.1",
        "morgan": "^1.12.1",
        "mysql2": "^3.24.6",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/http-errors": "^2.0.5",
        "@types/morgan": "^1.9.10",
        "@types/node": "^20.19.27",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "nodemon": "^3.1.14",
        "prettier": "3.9.10",
        "rimraf": "^5.0.10",
        "supertest": "^7.3.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.9.9",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts,cts,mts}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
